{
  "name": "@tiltx/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "TiltX WebSocket backend — rooms, pairing, validation, latency",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@tiltx/shared": "*",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.1",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.10.1",
    "@types/supertest": "^6.0.3",
    "socket.io-client": "^4.8.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
