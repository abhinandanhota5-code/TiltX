# TiltX server configuration
# Copy to .env (never commit .env — it may contain LAN-specific values)

# Port the Socket.IO/Express server listens on.
PORT=3001

# Interface to bind. 0.0.0.0 exposes the server on every interface so a phone
# on the same Wi-Fi network can reach it. Use 127.0.0.1 to restrict to this
# machine only. See README "Security considerations" before exposing to a LAN.
HOST=0.0.0.0

# Comma-separated list of allowed CORS origins for browser clients.
# Leave empty to allow any origin (development convenience only).
CORS_ORIGINS=

# Full URL placed into the pairing QR code. Normally leave this EMPTY: the
# server auto-detects the Mac's reachable LAN address and combines it with
# CONTROLLER_PORT, so the QR keeps working when the laptop changes Wi-Fi.
# Set it only to override that, e.g. behind a reverse proxy:
#   CONTROLLER_BASE_URL=https://tiltx.example.com
CONTROLLER_BASE_URL=

# Port of the CONTROLLER dev server, used to build the pairing URL when
# CONTROLLER_BASE_URL is empty. Must match the controller's own PORT. Default 5173.
# Both servers are different apps: the game is 5174, the controller is 5173.
CONTROLLER_PORT=5173

# Optional escape hatch for LAN auto-detection: pin a specific address when
# several interfaces exist and the wrong one is picked (e.g. a VPN is up).
# Find candidates with: npm run lan:ip
LAN_ADDRESS_OVERRIDE=

# Secret used to sign short-lived pairing tokens (HMAC-SHA256).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If unset, a random secret is generated at boot (pairing tokens then only
# survive until the server restarts).
PAIRING_SECRET=

# Lifetime of a pairing token, in seconds. Default 900 (15 minutes).
PAIRING_TOKEN_TTL=900

# Maximum accepted controller input packets per second, per socket. Default 90.
MAX_INPUT_RATE=90

# Milliseconds without a controller packet before the controller is
# considered stalled. Default 500.
INPUT_STALL_MS=500

# How long the backend keeps a room alive after the game (laptop) socket
# drops, waiting for it to reconnect. Default 30000.
GAME_GRACE_MS=30000

# Room idle lifetime in seconds — rooms with no members are removed after
# this long. Default 1800.
ROOM_TTL_SECONDS=1800

# Log level: debug | info | warn | error | silent
LOG_LEVEL=info
