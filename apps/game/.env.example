# TiltX game (laptop browser) configuration
# Copy to .env.local for local overrides.

# Vite dev server port.
PORT=5174

# Where the dev server proxies /socket.io to (the TiltX backend).
# Keep this pointing at localhost — the game runs on the laptop.
VITE_DEV_SERVER_PROXY=http://localhost:3001

# Absolute base URL used to build the controller pairing link (QR code).
# Leave empty — the backend auto-detects the Mac's reachable LAN address and
# combines it with CONTROLLER_PORT (see server/.env), so nothing has to change
# when you switch Wi-Fi networks.
#
# Set it only to override, e.g. a tunnel:
#   VITE_PAIRING_BASE_URL=https://tiltx.example.com
# NOTE: this is the CONTROLLER's address (default http://<lan-ip>:5173), not
# the game's own port — they are separate dev servers.
VITE_PAIRING_BASE_URL=

# Optional absolute backend URL for the game itself. When empty the game
# connects to the same origin it was served from (works with the dev proxy).
VITE_SERVER_URL=
