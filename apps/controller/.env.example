# TiltX controller (phone browser / Android app) configuration
# Copy to .env.local for local overrides.

# Vite dev server port. The backend pairs phones to this port via
# CONTROLLER_PORT (server/.env) — keep the two in sync if you change it.
PORT=5173

# Dev proxy target: /socket.io on this dev server is forwarded to the backend.
# This is how a phone opened at http://<mac-lan-ip>:5173 reaches a backend
# listening on localhost without hardcoding an IP in the app.
VITE_DEV_SERVER_PROXY=http://localhost:3001

# Absolute backend URL. Leave empty to use the dev proxy / same origin.
# Set it only if you serve the controller from somewhere that cannot proxy,
# e.g. inside the Android app packaged with Capacitor:
#   VITE_SERVER_URL=http://192.168.1.42:3001
# Find your Mac's IP with: npm run lan:ip
# NEVER hardcode this into source; .env.local is gitignored.
VITE_SERVER_URL=

# Target input rate in updates per second sent to the backend (40–60).
VITE_INPUT_HZ=55
